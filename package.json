{
  "name": "qa-mart-lab",
  "version": "4.0.0",
  "private": true,
  "description": "QA Mart lab: Playwright practice and a playground for building GitHub Copilot agent customizations",
  "scripts": {
    "start": "node app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:v2": "playwright test --project=ui-v2",
    "test:legacy": "playwright test --project=legacy",
    "test:seeded": "playwright test --project=seeded",
    "typecheck": "tsc --noEmit",
    "lint:specs": "node scripts/lint-specs.cjs",
    "mcp:smoke": "node scripts/mcp-smoke.cjs",
    "flaky": "playwright test --project=legacy --repeat-each=5",
    "codegen": "playwright codegen --output tests/lab/recorded.spec.ts http://localhost:3000/login",
    "demo:trace": "playwright test --project=demo --trace on",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
